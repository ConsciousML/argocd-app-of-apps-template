{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "required": ["vpcEndpointCidrs", "external-dns"],
  "properties": {
    "vpcEndpointCidrs": {
      "type": "object",
      "required": ["route53"],
      "properties": {
        "route53": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "external-dns": {
      "type": "object",
      "required": ["txtOwnerId", "txtPrefix", "domainFilters"],
      "properties": {
        "txtOwnerId": { "type": "string", "minLength": 1 },
        "txtPrefix": { "type": "string", "minLength": 1 },
        "domainFilters": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
