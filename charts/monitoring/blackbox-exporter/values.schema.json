{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "required": ["prometheus-blackbox-exporter"],
  "properties": {
    "prometheus-blackbox-exporter": {
      "type": "object",
      "required": ["serviceMonitor"],
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "required": ["targets"],
          "properties": {
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "url"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "url": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
